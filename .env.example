# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate DATA_ENCRYPTION_KEY with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# Address the app's port 8083 is published on. 127.0.0.1 = reachable only through the host nginx
# (ai.bullmachine.in). Use 0.0.0.0 only if the firewall limits port 8083 to the office network.
APP_BIND_ADDRESS=127.0.0.1
# URL prefix the app is served under on ai.bullmachine.in (nginx location /aicall/ -> 127.0.0.1:8083).
# Empty = site root. Changing it needs a rebuild (docker compose ... up -d --build): the frontend is built for it.
BASE_PATH=/aicall

# --- PostgreSQL (container) ---
POSTGRES_USER=bullcall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bullcall
# Used when running the app or tests on the host against the dev ports in docker-compose.dev.yml.
# Inside Docker, docker-compose.yml builds DATABASE_URL from the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://bullcall:c33ca8c7d4954d2d9cdc7c19a280cd60@127.0.0.1:55433/bullcall
TEST_DATABASE_URL=postgresql+psycopg://bullcall:c33ca8c7d4954d2d9cdc7c19a280cd60@127.0.0.1:55433/bullcall_test

# --- Redis (container) ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:d8e8dd036f4a9f236d11357e47277500@127.0.0.1:56379/0

# --- Security ---
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# Fernet key: encrypts phone numbers and provider credentials. Losing it makes stored numbers unreadable.
DATA_ENCRYPTION_KEY=
# Keyed hash for phone look-ups and duplicate detection. Changing it breaks duplicate detection.
PHONE_HASH_KEY=
DEFAULT_PHONE_REGION=IN

# JSON list of allowed browser origins, e.g. ["https://voicecall.example.com"]
CORS_ORIGINS=[]

# --- Approvals ---
# true: a script or campaign must be approved by someone other than its author (admins excepted).
# false: the author can publish their own script and approve their own campaign in one step.
REQUIRE_SECOND_APPROVER=true

# --- Calling ---
# disabled: no calls. mock: simulated calls for development (refused when APP_ENV=production). live: real calls.
TELEPHONY_MODE=disabled
# The https address FreJun uses to reach this server, including BASE_PATH. Required for live.
# Set by deploy/tunnel.sh (Cloudflare quick tunnel): https://<random>.trycloudflare.com/aicall
PUBLIC_URL=https://mood-comics-ink-standings.trycloudflare.com/aicall
# FreJun (Teler)
TELER_API_KEY=
FREJUN_PHONE_NUMBER=
TELER_TIMEOUT_SECONDS=20
# Gemini Live (speech to speech). The model PO Agent uses on this server.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Caller silence (ms) before the agent replies: lower is snappier, too low cuts in on pauses.
GEMINI_SILENCE_MS=300
# Absolute limit for any call, whatever the script says.
MAX_CALL_SECONDS_HARD=900
# Individual calls only inside calling hours (Mon-Sat 09:30-18:30 IST, pending compliance confirmation).
INDIVIDUAL_CALL_WINDOW_ENFORCED=true
# Text model (LangChain) that turns each call into the script's structured result after it ends.
GEMINI_TEXT_MODEL=gemini-flash-latest
# Simultaneous calls the FreJun line carries. 1 = one by one: the campaign dialer waits for each call to end.
CALL_CHANNELS=1
# The campaign dialer (inside the app) checks for the next contact this often, in seconds.
DIALER_INTERVAL_SECONDS=5
# LangSmith tracing is off unless LANGSMITH_TRACING=true is set; it would send call content to LangSmith.
